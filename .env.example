# Copy to .env and fill in. Never commit .env. Nothing here is needed for a dry run on public job boards.

# Browser agent (only for --live applying). Browserbase plan: https://www.browserbase.com/pricing
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Created once by `python -m jobagent browser-context`, then reused so site logins persist.
BROWSERBASE_CONTEXT_ID=

# Password manager for the few sites that need a login. Pick one.
# Bitwarden: run `bw unlock` and export BW_SESSION in the same shell.  1Password: sign in with `op signin`.
VAULT=bitwarden        # bitwarden | 1password | none

# Optional model for tailoring (any OpenAI-compatible API; OpenRouter shown). Leave blank to use the
# no-model mode, which only reuses your own profile bullets word for word.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5

# Optional second opinion on model-written drafts, from a DIFFERENT model than LLM_MODEL (uses the same key and base URL).
# It catches plain-prose inventions the regex check cannot see. Leave blank to skip.
JUDGE_MODEL=
